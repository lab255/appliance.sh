{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBundleCommand": "node scripts/sign-staged.mjs"
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "windows": {
      "signCommand": {
        "cmd": "node",
        "args": ["../scripts/win-sign.mjs", "%1"]
      }
    }
  }
}
