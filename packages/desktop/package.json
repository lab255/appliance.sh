{
  "name": "@appliance.sh/desktop",
  "version": "1.55.1",
  "private": true,
  "description": "Tauri shell for the Appliance desktop app",
  "license": "MIT",
  "author": "Eliot Lim",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run sidecar:build && pnpm run cli:bundle && pnpm run vm:build && pnpm run vm:bundle && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf ./dist ./sidecar/dist ./src-tauri/binaries ./src-tauri/vm-bin ./src-tauri/apiserver-bin",
    "deps:build": "nx run-many -t build -p @appliance.sh/cli @appliance.sh/app @appliance.sh/bootstrap @appliance.sh/helper",
    "sidecar:build": "tsc -p sidecar/tsconfig.json --noEmit && bun build sidecar/src/main.ts --target=node --outfile=sidecar/dist/main.mjs",
    "cli:bundle": "node scripts/copy-cli.mjs",
    "vm:build": "node scripts/build-vm.mjs",
    "vm:bundle": "node scripts/copy-vm.mjs",
    "apiserver:stage": "node scripts/stage-apiserver.mjs",
    "apiserver:clear": "node scripts/stage-apiserver.mjs --clear",
    "tauri": "tauri",
    "tauri:dev": "pnpm deps:build && pnpm sidecar:build && pnpm cli:bundle && pnpm vm:build && pnpm vm:bundle && pnpm apiserver:stage && tauri dev",
    "tauri:build": "pnpm deps:build && pnpm sidecar:build && pnpm cli:bundle && pnpm vm:build && pnpm vm:bundle && pnpm apiserver:stage && tauri build && node scripts/sign-macos.mjs",
    "tauri:build:release": "pnpm sidecar:build && pnpm cli:bundle && pnpm vm:build && pnpm vm:bundle && pnpm apiserver:clear && tauri build --config src-tauri/tauri.release.conf.json && node scripts/notarize-macos.mjs",
    "dev:setup": "echo 'pnpm workspaces handle linking automatically'"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist",
          "{projectRoot}/sidecar/dist"
        ]
      },
      "test": {
        "inputs": [
          "default",
          "{workspaceRoot}/packages/cli/src/utils/agent.ts",
          "{workspaceRoot}/packages/app/src/lib/agents.ts",
          "{workspaceRoot}/packages/desktop/src-tauri/src/lib.rs"
        ]
      }
    }
  },
  "dependencies": {
    "@appliance.sh/app": "workspace:*",
    "@appliance.sh/bootstrap": "workspace:*",
    "@appliance.sh/install-aws": "workspace:*",
    "@appliance.sh/helper": "workspace:*",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-notification": "^2.2.0",
    "@tauri-apps/plugin-process": "^2.2.0",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "@tauri-apps/plugin-updater": "^2.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@appliance.sh/cli": "workspace:*",
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "24.12.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
