exports[`appliance CloudFormation template > snapshots every scoped execution-role policy document > api-server scoped policy 1`] = `
{
  "Statement": [
    {
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket",
      ],
      "Effect": "Allow",
      "Resource": {
        "tag": "!GetAtt",
        "value": "DataBucket.Arn",
      },
      "Sid": "DataBucketMetadata",
    },
    {
      "Action": [
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:PutObject",
      ],
      "Effect": "Allow",
      "Resource": {
        "tag": "!Sub",
        "value": "\${DataBucket.Arn}/*",
      },
      "Sid": "DataBucketObjects",
    },
  ],
  "Version": "2012-10-17",
}
`;

exports[`appliance CloudFormation template > snapshots every scoped execution-role policy document > worker provisioning scoped policy 1`] = `
