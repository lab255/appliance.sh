exports[`appliance CloudFormation template > snapshots every scoped execution-role policy document > worker runtime scoped policy 1`] = `
{
  "Statement": [
    {
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket",
      ],
      "Effect": "Allow",
      "Resource": {
        "tag": "!GetAtt",
        "value": "DataBucket.Arn",
      },
      "Sid": "DataBucketMetadata",
    },
    {
      "Action": [
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:PutObject",
      ],
      "Effect": "Allow",
      "Resource": {
        "tag": "!Sub",
        "value": "\${DataBucket.Arn}/*",
      },
      "Sid": "DataBucketObjects",
    },
    {
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket",
      ],
      "Effect": "Allow",
      "Resource": {
        "tag": "!GetAtt",
        "value": "StateBucket.Arn",
      },
      "Sid": "PulumiStateBucketMetadata",
    },
    {
      "Action": [
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:PutObject",
      ],
      "Effect": "Allow",
      "Resource": {
        "tag": "!Sub",
        "value": "\${StateBucket.Arn}/*",
      },
      "Sid": "PulumiStateObjects",
    },
    {
      "Action": [
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:Encrypt",
        "kms:GenerateDataKey",
      ],
      "Effect": "Allow",
      "Resource": {
        "tag": "!GetAtt",
        "value": "StateKmsKey.Arn",
      },
      "Sid": "PulumiSecretsKey",
    },
    {
      "Action": "ecr:GetAuthorizationToken",
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "EcrAuthorization",
    },
    {
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:CompleteLayerUpload",
        "ecr:DescribeImages",
        "ecr:GetDownloadUrlForLayer",
        "ecr:GetRepositoryPolicy",
        "ecr:InitiateLayerUpload",
        "ecr:ListImages",
        "ecr:PutImage",
        "ecr:UploadLayerPart",
      ],
      "Effect": "Allow",
      "Resource": {
        "tag": "!GetAtt",
        "value": "ImageRepository.Arn",
      },
      "Sid": "InstallationRepository",
    },
    {
      "Action": "sts:GetCallerIdentity",
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "AccountIdentity",
    },
    {
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource",
      ],
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "AwsNativeCloudControl",
    },
  ],
  "Version": "2012-10-17",
}
`;
