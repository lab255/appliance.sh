// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`appliance CloudFormation template > snapshots both scoped execution-role policy documents > api-server scoped policy 1`] = `
{
  "Statement": [
    {
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket",
      ],
      "Effect": "Allow",
      "Resource": "DataBucket.Arn",
      "Sid": "DataBucketMetadata",
    },
    {
      "Action": [
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:PutObject",
      ],
      "Effect": "Allow",
      "Resource": "\${DataBucket.Arn}/*",
      "Sid": "DataBucketObjects",
    },
    {
      "Action": "secretsmanager:GetSecretValue",
      "Effect": "Allow",
      "Resource": "BootstrapTokenSecret",
      "Sid": "BootstrapTokenRead",
    },
  ],
  "Version": "2012-10-17",
}
`;

exports[`appliance CloudFormation template > snapshots both scoped execution-role policy documents > worker scoped policy 1`] = `
{
  "Statement": [
    {
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket",
      ],
      "Effect": "Allow",
      "Resource": "DataBucket.Arn",
      "Sid": "DataBucketMetadata",
    },
    {
      "Action": [
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:PutObject",
      ],
      "Effect": "Allow",
      "Resource": "\${DataBucket.Arn}/*",
      "Sid": "DataBucketObjects",
    },
    {
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket",
      ],
      "Effect": "Allow",
      "Resource": "StateBucket.Arn",
      "Sid": "PulumiStateBucketMetadata",
    },
    {
      "Action": [
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:PutObject",
      ],
      "Effect": "Allow",
      "Resource": "\${StateBucket.Arn}/*",
      "Sid": "PulumiStateObjects",
    },
    {
      "Action": [
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:Encrypt",
        "kms:GenerateDataKey",
      ],
      "Effect": "Allow",
      "Resource": "StateKmsKey.Arn",
      "Sid": "PulumiSecretsKey",
    },
    {
      "Action": "ecr:GetAuthorizationToken",
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "EcrAuthorization",
    },
    {
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:CompleteLayerUpload",
        "ecr:DeleteRepositoryPolicy",
        "ecr:DescribeImages",
        "ecr:GetDownloadUrlForLayer",
        "ecr:GetRepositoryPolicy",
        "ecr:InitiateLayerUpload",
        "ecr:ListImages",
        "ecr:PutImage",
        "ecr:SetRepositoryPolicy",
        "ecr:UploadLayerPart",
      ],
      "Effect": "Allow",
      "Resource": "ImageRepository.Arn",
      "Sid": "InstallationRepository",
    },
    {
      "Action": "sts:GetCallerIdentity",
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "AccountIdentity",
    },
    {
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource",
      ],
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "AwsNativeCloudControl",
    },
    {
      "Action": [
        "iam:AttachRolePolicy",
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:ListRolePolicies",
        "iam:PassRole",
        "iam:PutRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy",
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:\${AWS::Partition}:iam::\${AWS::AccountId}:role/appliance/*",
        "arn:\${AWS::Partition}:iam::\${AWS::AccountId}:role/*-edge-router-role-*",
      ],
      "Sid": "ApplianceIamRoles",
    },
    {
      "Action": [
        "iam:CreatePolicy",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicy",
        "iam:DeletePolicyVersion",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListPolicyTags",
        "iam:ListPolicyVersions",
        "iam:SetDefaultPolicyVersion",
        "iam:TagPolicy",
        "iam:UntagPolicy",
      ],
      "Effect": "Allow",
      "Resource": "arn:\${AWS::Partition}:iam::\${AWS::AccountId}:policy/appliance/*",
      "Sid": "ApplianceIamPolicies",
    },
    {
      "Action": "iam:CreateServiceLinkedRole",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "replicator.lambda.amazonaws.com",
            "logger.cloudfront.amazonaws.com",
          ],
        },
      },
      "Effect": "Allow",
      "Resource": "arn:\${AWS::Partition}:iam::\${AWS::AccountId}:role/aws-service-role/*",
      "Sid": "LambdaEdgeServiceLinkedRoles",
    },
    {
      "Action": [
        "lambda:AddPermission",
        "lambda:CreateFunction",
        "lambda:CreateFunctionUrlConfig",
        "lambda:DeleteFunction",
        "lambda:DeleteFunctionUrlConfig",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:GetFunctionUrlConfig",
        "lambda:GetPolicy",
        "lambda:ListTags",
        "lambda:ListVersionsByFunction",
        "lambda:PublishVersion",
        "lambda:RemovePermission",
        "lambda:TagResource",
        "lambda:UntagResource",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:UpdateFunctionUrlConfig",
      ],
      "Effect": "Allow",
      "Resource": "arn:\${AWS::Partition}:lambda:*:\${AWS::AccountId}:function:*",
      "Sid": "ApplianceFunctions",
    },
    {
      "Action": [
        "lambda:DisableReplication*",
        "lambda:EnableReplication*",
      ],
      "Effect": "Allow",
      "Resource": "arn:\${AWS::Partition}:lambda:us-east-1:\${AWS::AccountId}:function:*:*",
      "Sid": "LambdaEdgeReplication",
    },
    {
      "Action": [
        "cloudfront:CreateDistribution",
        "cloudfront:CreateOriginAccessControl",
        "cloudfront:ListCachePolicies",
        "cloudfront:ListOriginAccessControls",
        "cloudfront:ListOriginRequestPolicies",
      ],
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "CloudFrontAccountOperations",
    },
    {
      "Action": [
        "cloudfront:DeleteDistribution",
        "cloudfront:DeleteOriginAccessControl",
        "cloudfront:GetDistribution",
        "cloudfront:GetDistributionConfig",
        "cloudfront:GetOriginAccessControl",
        "cloudfront:GetOriginAccessControlConfig",
        "cloudfront:ListTagsForResource",
        "cloudfront:TagResource",
        "cloudfront:UntagResource",
        "cloudfront:UpdateDistribution",
        "cloudfront:UpdateOriginAccessControl",
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:\${AWS::Partition}:cloudfront::\${AWS::AccountId}:distribution/*",
        "arn:\${AWS::Partition}:cloudfront::\${AWS::AccountId}:origin-access-control/*",
      ],
      "Sid": "ApplianceCloudFrontResources",
    },
    {
      "Action": [
        "cloudfront:GetCachePolicy",
        "cloudfront:GetOriginRequestPolicy",
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:\${AWS::Partition}:cloudfront::aws:cache-policy/*",
        "arn:\${AWS::Partition}:cloudfront::aws:origin-request-policy/*",
      ],
      "Sid": "AwsManagedCloudFrontPolicies",
    },
    {
      "Action": "route53:CreateHostedZone",
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "Route53CreateHostedZone",
    },
    {
      "Action": [
        "route53:ChangeResourceRecordSets",
        "route53:ChangeTagsForResource",
        "route53:DeleteHostedZone",
        "route53:GetHostedZone",
        "route53:ListResourceRecordSets",
        "route53:ListTagsForResource",
      ],
      "Effect": "Allow",
      "Resource": "arn:\${AWS::Partition}:route53:::hostedzone/*",
      "Sid": "ApplianceHostedZones",
    },
    {
      "Action": "route53:GetChange",
      "Effect": "Allow",
      "Resource": "arn:\${AWS::Partition}:route53:::change/*",
      "Sid": "Route53Changes",
    },
    {
      "Action": "acm:RequestCertificate",
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "AcmRequestCertificate",
    },
    {
      "Action": [
        "acm:AddTagsToCertificate",
        "acm:DeleteCertificate",
        "acm:DescribeCertificate",
        "acm:ListTagsForCertificate",
        "acm:RemoveTagsFromCertificate",
      ],
      "Effect": "Allow",
      "Resource": "arn:\${AWS::Partition}:acm:*:\${AWS::AccountId}:certificate/*",
      "Sid": "ApplianceCertificates",
    },
    {
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:DeleteRetentionPolicy",
        "logs:ListTagsForResource",
        "logs:PutRetentionPolicy",
        "logs:TagResource",
        "logs:UntagResource",
      ],
      "Effect": "Allow",
      "Resource": "arn:\${AWS::Partition}:logs:*:\${AWS::AccountId}:log-group:/appliance/*",
      "Sid": "ApplianceLogGroups",
    },
    {
      "Action": [
        "logs:DescribeDeliveries",
        "logs:DescribeDeliveryDestinations",
        "logs:DescribeDeliverySources",
        "logs:DescribeLogGroups",
      ],
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "LogsAccountDiscovery",
    },
    {
      "Action": [
        "logs:CreateDelivery",
        "logs:DeleteDelivery",
        "logs:DeleteDeliveryDestination",
        "logs:DeleteDeliverySource",
        "logs:GetDelivery",
        "logs:GetDeliveryDestination",
        "logs:GetDeliverySource",
        "logs:ListTagsForResource",
        "logs:PutDeliveryDestination",
        "logs:PutDeliverySource",
        "logs:TagResource",
        "logs:UntagResource",
        "logs:UpdateDeliveryConfiguration",
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:\${AWS::Partition}:logs:*:\${AWS::AccountId}:delivery:*",
        "arn:\${AWS::Partition}:logs:*:\${AWS::AccountId}:delivery-destination:*",
        "arn:\${AWS::Partition}:logs:*:\${AWS::AccountId}:delivery-source:*",
      ],
      "Sid": "ApplianceLogDeliveryResources",
    },
  ],
  "Version": "2012-10-17",
}
`;
