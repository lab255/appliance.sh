        "iam:DeleteRolePermissionsBoundary",
        "iam:PutRolePermissionsBoundary",
      ],
      "Effect": "Deny",
      "Resource": {
        "tag": "!Sub",
        "value": "arn:\${AWS::Partition}:iam::\${AWS::AccountId}:role/appliance/*",
      },
