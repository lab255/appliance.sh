{
  "name": "@appliance.sh/api-server",
  "version": "1.55.1",
  "private": true,
  "description": "",
  "author": "Eliot Lim",
  "repository": {
    "type": "git",
    "url": "https://github.com/lab255/appliance.sh.git",
    "directory": "packages/api-server"
  },
  "license": "MIT",
  "main": "dist/src/app.js",
  "types": "dist/src/app.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "compile:guest-x64": "bun build src/main.ts --compile --target=bun-linux-x64-musl --outfile=dist/guest/appliance-api-server-linux-x64",
    "compile:guest-arm64": "bun build src/main.ts --compile --target=bun-linux-arm64-musl --outfile=dist/guest/appliance-api-server-linux-arm64",
    "compile:guest": "pnpm run compile:guest-x64 && pnpm run compile:guest-arm64",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/src/main.js",
    "start:dev": "tsx watch src/main.ts",
    "start:debug": "tsx watch --inspect src/main.ts",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@appliance.sh/infra": "workspace:*",
    "@appliance.sh/sdk": "workspace:*",
    "@aws-sdk/client-ecr": "^3.1005.0",
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.1009.0",
    "cors": "^2.8.5",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/node": "24.12.2",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.4"
  }
}
